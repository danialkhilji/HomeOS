# HomeOS Configuration
# Copy this file to .env and adjust values as needed.

# Application
APP_NAME=HomeOS
DEBUG=True
VERSION=0.1.0

# Database (SQLite for development, swap to PostgreSQL later)
# DATABASE_URL=sqlite+aiosqlite:///./homeos.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/homeos

# CORS (comma-separated origins allowed to call the API)
CORS_ORIGINS=["http://localhost:5173"]

# API
API_V1_PREFIX=/api/v1

# Weather (set your location coordinates)
WEATHER_LATITUDE=51.5074
WEATHER_LONGITUDE=-0.1278
WEATHER_CACHE_MINUTES=30
